{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, balance, transactions, and status configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "balance": { "type": "number" },
        "profileImage": { "type": "string" },
        "deactivationDate": { "type": "integer" },
        "imminentDeactivationExpiry": { "type": "integer" },
        "isVIP": { "type": "boolean" },
        "vipBalance": { "type": "number" },
        "loanBalance": { "type": "number" },
        "loanExpiry": { "type": "integer" },
        "isPMode": { "type": "boolean" },
        "isVMode": { "type": "boolean" },
        "lastTelegramClaimTimestamp": { "type": "integer" },
        "dailyQuizCount": { "type": "integer" },
        "lastQuizTimestamp": { "type": "integer" },
        "activationStatus": { "type": "string", "enum": ["inactive", "pending", "active", "banned"] },
        "activationPlan": { "type": "string", "enum": ["weekly", "monthly", "yearly"] },
        "activationSubmitTime": { "type": "integer" },
        "activationProofBase64": { "type": "string" },
        "referredBy": { "type": "string" }
      },
      "required": ["name", "email", "balance"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Administrative system settings configurations such as payment destinations",
      "type": "object",
      "properties": {
        "accountNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "accountName": { "type": "string" }
      },
      "required": ["accountNumber", "bankName", "accountName"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "A pending or verified bank withdrawal request.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"] }
      },
      "required": ["userId", "bankName", "accountNumber", "accountName", "amount", "timestamp", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of all user accounts indexed by user email address or user UID"
    },
    "/settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Global administrative configurations stored securely in Firestore"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "User withdrawal requests for audit, verification, and processing"
    }
  }
}
